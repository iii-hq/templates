# Copy to .env and fill in. `chmod 600 .env` after you do.
#
# An empty or missing key does not stop a container from starting. That provider
# answers with an auth error when the harness first calls it. You need at least
# one working provider for the harness to do anything.

# Set the API KEY for your provider, by default harness ships with anthropic, and openai
# providers pre-installed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# More providers
# Uncomment whichever one you need and add that provider to worker-compose.yaml
# DEEPSEEK_API_KEY=          # provider-deepseek
# MOONSHOT_API_KEY=          # provider-kimi
# XAI_API_KEY=               # provider-xai
# ZAI_API_KEY=               # provider-zai
# OPENROUTER_API_KEY=        # provider-openrouter
# LLAMACPP_API_KEY=          # provider-llamacpp

# Note: There are additional providers that do not require an API KEY
# to operate. Refer to worker-compose.yaml for those.