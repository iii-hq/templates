# Anthropic, OpenAI and DeepSeek providers are enabled by default. Paste the
# key for at least one of them and leave the others empty.
# Keys go here, not in a shell export: llm-router reads this file, and a line
# here, even an empty one, takes precedence over an exported variable.
# After editing this file while the project is running, restart llm-router so
# it picks up the change: iii trigger compose::restart worker=llm-router
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Uncomment the line for each extra provider you enable in worker-compose.yaml,
# then restart the compose daemon (stop `iii compose --up` and run it again).
# MOONSHOT_API_KEY=
# XAI_API_KEY=
# ZAI_API_KEY=
# OPENROUTER_API_KEY=
# LLAMACPP_API_KEY=
