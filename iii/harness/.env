# OpenAI and Anthropic providers are included by default, for others please
# uncomment their respective lines in worker-compose.yaml.
# When adding a new key to this file restart llm-router so it picks up the
# changed env file: iii trigger compose::restart worker=llm-router
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Uncomment the line for each extra provider you enable in worker-compose.yaml.
# Then run iii trigger compose::restart
# MOONSHOT_API_KEY=
# XAI_API_KEY=
# ZAI_API_KEY=
# OPENROUTER_API_KEY=
# LLAMACPP_API_KEY=
