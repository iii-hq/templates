# Provider API keys, if you prefer keeping them in this file. Nothing reads it
# by itself: connect the provider in the ADE (the setup wizard on the first
# visit, or Configure in the model picker). The wizard finds a key here; choose
# "Environment variable" to keep it here, and the secrets worker reads it on
# every use, so an edit applies without a restart. A key pasted in the ADE is
# stored encrypted instead. This file is listed in .gitignore.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# For each extra provider you enable in worker-compose.yaml.
# MOONSHOT_API_KEY=
# XAI_API_KEY=
# ZAI_API_KEY=
# OPENROUTER_API_KEY=
# LLAMACPP_API_KEY=
