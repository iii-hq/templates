# Provider credentials for the agent. The Anthropic and OpenAI providers ship
# enabled in worker-compose.yaml; put the key for the one you use here, then
# start Compose. llm-router and the provider worker read this file, and the
# provider reaches its API with the key. A provider with no key still starts but
# stays unconfigured, so leaving one blank is fine.
#
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
