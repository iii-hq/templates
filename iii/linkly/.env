# OpenAI and Anthropic providers are included by default, for others please
# uncomment their respective lines in worker-compose.yaml.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Uncomment the line for each extra provider you enable in worker-compose.yaml.
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# XAI_API_KEY=
# ZAI_API_KEY=
# OPENROUTER_API_KEY=
# LLAMACPP_API_KEY=

# Chapter 7 (frontend): the shared secret the auth::browser function checks
# before it admits a browser connection through rbac-proxy. Change it for any
# real deployment; the auth worker admits no browser when it is unset.
LINKLY_BROWSER_TOKEN=dev-token
